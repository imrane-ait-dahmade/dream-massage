{
  "name": "dream-massage-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:clean": "tsx prisma/seed.ts --clean-runtime",
    "prisma:seed:staff-planning": "tsx prisma/seed-staff-planning.ts",
    "prisma:seed:shifts": "SEED_SHIFT_TABLE=true tsx prisma/seed.ts",
    "extract:staff-planning": "tsx scripts/extract-staff-planning-from-dump.ts",
    "db:push": "prisma db push",
    "backfill:staff-members": "tsx scripts/backfill-staff-members.ts",
    "test:shift-close": "tsx modules/shifts/shift-close.logic.test.ts",
    "test:self-start-shift": "tsx modules/shifts/shift-self-start.logic.test.ts",
    "test:auto-shift-check": "tsx modules/shifts/auto-shift-check.test.ts",
    "test:schedule-period": "tsx modules/settings/schedule-period.test.ts",
    "test:archive": "tsx modules/archive/archive-filters.test.ts",
    "test:session-delete": "tsx modules/sessions/session-delete.logic.test.ts",
    "test:session-plan-change": "tsx modules/sessions/session-plan-change.logic.test.ts",
    "test:shift-delete": "tsx modules/shifts/shift-delete.logic.test.ts",
    "test:dashboard-dates": "tsx modules/dashboard/date-range.test.ts",
    "test:dashboard-metrics": "tsx modules/dashboard/session-metrics.logic.test.ts",
    "test:dashboard-filters": "tsx modules/dashboard/dashboard-filters.test.ts",
    "test:neon-egress": "tsx modules/chairs/neon-egress.hotfix.test.ts",
    "test:neon-soak": "tsx modules/chairs/neon-egress.soak.test.ts",
    "test:cash": "tsx modules/cash/cash.logic.test.ts && tsx modules/cash/cash-access.logic.test.ts && tsx modules/cash/cash-prime.logic.test.ts",
    "test": "tsx modules/shifts/shift-close.logic.test.ts && tsx modules/shifts/shift-self-start.logic.test.ts && tsx modules/shifts/auto-shift-check.test.ts && tsx modules/settings/schedule-period.test.ts && tsx modules/archive/archive-filters.test.ts && tsx modules/sessions/session-delete.logic.test.ts && tsx modules/sessions/session-plan-change.logic.test.ts && tsx modules/shifts/shift-delete.logic.test.ts && tsx modules/dashboard/date-range.test.ts && tsx modules/dashboard/session-metrics.logic.test.ts && tsx modules/dashboard/dashboard-filters.test.ts && tsx modules/chairs/neon-egress.hotfix.test.ts && tsx modules/chairs/neon-egress.soak.test.ts && tsx modules/cash/cash.logic.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.3"
  }
